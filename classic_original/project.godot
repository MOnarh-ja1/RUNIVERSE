; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="RUNIVERSE"
config/description="RUNIVERSE: 50 героев, 5 миров, анимации и способности — MgameIO"
run/main_scene="res://boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.035, 0.075, 0.12, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/boot_logo.png"
config/icon="res://assets/icon.svg"
config/windows_native_icon="res://assets/icon.ico"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/runiverse.log"

[display]

window/size/viewport_width=1672
window/size/viewport_height=941
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/size/min_width=960
window/size/min_height=540

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.11, 0.19, 0.24, 1)
